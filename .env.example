# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase (opcional no começo: sem ele os pedidos vão só pelo WhatsApp)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave secreta (Project Settings > API Keys > Secret keys, começa com sb_secret_). Só no servidor.
SUPABASE_SECRET_KEY=

# Acesso ao painel do restaurante em /painel
PAINEL_USUARIO=admin
PAINEL_SENHA=
